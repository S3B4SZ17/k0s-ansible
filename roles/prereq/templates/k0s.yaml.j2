---
apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s
  namespace: kube-system
spec:
  api:
    address: {{ k0s_control_plane_ip }}
    ca:
      certificatesExpireAfter: 8760h0m0s
      expiresAfter: 87600h0m0s
    k0sApiPort: 9443
    port: 6443
    sans:
    - {{ k0s_control_plane_ip }}
    extraArgs:
      encryption-provider-config: {{ k0s_data_dir }}/encryption/encryption-config.yaml
    # Add more interfaces/IPs as needed
  controllerManager: {}
  extensions:
    helm:
      repositories:
        - name: longhorn
          url: https://charts.longhorn.io
      charts:
        - name: longhorn
          chartname: longhorn/longhorn
          namespace: longhorn-system
          version: 1.13.0
          values: |
            longhornUI:
              # -- Replica count for Longhorn UI.
              replicas: 1
            csi:
              # -- kubelet root directory. When unspecified, Longhorn uses the default value.
              kubeletRootDir: /var/lib/k0s/kubelet
            global:
              tolerations:
                - key: "mode"
                  operator: "Equal"
                  value: "power"
                  effect: "NoSchedule"              
            defaultSettings:
              taintToleration: "mode=power:NoSchedule"
      concurrencyLevel: 5
  installConfig:
    users:
      etcdUser: etcd
      kineUser: kube-apiserver
      konnectivityUser: konnectivity-server
      kubeAPIserverUser: kube-apiserver
      kubeSchedulerUser: kube-scheduler
  konnectivity:
    adminPort: 8133
    agentPort: 8132
  network:
    clusterDomain: cluster.local
    dualStack:
      enabled: false
    kubeProxy:
      disabled: false
    kuberouter:
      autoMTU: true
      hairpin: Enabled
      metricsPort: 8080
    nodeLocalLoadBalancing:
      enabled: false
      envoyProxy:
        apiServerBindPort: 7443
        konnectivityServerBindPort: 7132
      type: EnvoyProxy
    podCIDR: 10.244.0.0/16
    provider: custom
    serviceCIDR: 10.96.0.0/12
  scheduler: {}
  storage:
    etcd:
      ca:
        certificatesExpireAfter: 8760h0m0s
        expiresAfter: 87600h0m0s
      peerAddress: {{ k0s_control_plane_ip }}
    type: etcd
  telemetry:
    enabled: false
